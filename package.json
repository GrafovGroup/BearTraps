{
  "name": "beartraps-ca",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/*.test.ts tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "check:catalogue": "node --experimental-strip-types scripts/check-catalogue.ts",
    "import:catalogue": "node --experimental-strip-types scripts/import-catalogue.ts",
    "catalogue:digests": "node --experimental-strip-types scripts/catalogue-digests.ts",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "playwright": "1.56.1",
    "@axe-core/playwright": "4.10.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module"
}
